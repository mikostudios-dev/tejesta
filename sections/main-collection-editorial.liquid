{{ 'tejesta-collection.css' | asset_url | stylesheet_tag }}
{{ 'tejesta-collection-editorial.css' | asset_url | stylesheet_tag }}
{{ 'tejesta-family-thumbnails.css' | asset_url | stylesheet_tag }}
<script src="{{ 'tejesta-collection-filters.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'tejesta-family-thumbnails.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  #TejestaCollectionEditorial-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #TejestaCollectionEditorial-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section
  id="TejestaCollectionEditorial-{{ section.id }}"
  class="tejesta-editorial gradient color-{{ section.settings.color_scheme }}"
>
  {%- liquid
    assign editorial_page_size = section.settings.products_per_page
    if collection.handle == 'all'
      assign editorial_page_size = 250
    endif
  -%}
  {%- paginate collection.products by editorial_page_size -%}
    {%- if section.settings.show_filters -%}
      <aside
        aria-label="Collection filters"
        class="tejesta-filters-wrapper tejesta-editorial__filters"
        id="main-collection-filters"
        data-id="{{ section.id }}"
      >
        {% render 'tejesta-collection-filters', results: collection %}
      </aside>
    {%- endif -%}

    {%- if collection.products.size == 0 -%}
      <div class="collection collection--empty page-width" id="product-grid" data-id="{{ section.id }}">
        <div class="title-wrapper center">
          <h2 class="title title--primary">
            {{ 'sections.collection_template.empty' | t }}
          </h2>
        </div>
      </div>
    {%- else -%}
      <div
        id="product-grid"
        class="tejesta-editorial__products"
        data-id="{{ section.id }}"
      >
        {%- assign seen_style_keys = '|' -%}
        {%- assign visible_style_count = 0 -%}
        {%- for product in collection.products -%}
          {%- liquid
            assign selected_variant = null
            assign available_variant_count = 0
            for variant in product.variants
              if variant.inventory_management != 'shopify' or variant.inventory_quantity > 0
                assign available_variant_count = available_variant_count | plus: 1
                if selected_variant == null
                  assign selected_variant = variant
                endif
              endif
            endfor

            assign selected_image = selected_variant.featured_media.preview_image
            if selected_image == blank
              assign selected_image = selected_variant.image
            endif
            if selected_image == blank
              assign selected_image = product.featured_media.preview_image
            endif

            assign style_key = product.metafields.custom.style_key.value | default: product.metafields.custom.style_key
            assign style_marker = '|' | append: style_key | append: '|'
            assign show_style = true
            if style_key != blank and seen_style_keys contains style_marker
              assign show_style = false
            endif

            assign style_title = product.metafields.custom.style_title.value
            if style_title == blank and style_key != blank
              assign style_title = ''
              assign style_words = style_key | replace: '-', ' ' | split: ' '
              for style_word in style_words
                assign display_word = style_word | capitalize
                if style_word == 'rx' or style_word == 'jpg'
                  assign display_word = style_word | upcase
                elsif style_word == 'x'
                  assign display_word = 'x'
                endif
                assign style_title = style_title | append: ' ' | append: display_word
              endfor
              assign style_title = style_title | strip
              if style_key == 'annie-o' or style_key == 'annie-o-rx'
                assign style_title = style_title | replace: 'Annie O', 'Annie-O'
              elsif style_key == 'colored-lenses'
                assign style_title = product.title
              endif
            endif
            if style_title == blank
              assign style_title = product.title
            endif

            assign selected_colorway = product.metafields.custom.colorway_label.value
            if selected_colorway == blank and style_key != blank
              assign colorway_source_title = product.title
              assign colorway_style_title = style_title
              if style_key contains '-rx'
                assign colorway_source_title = colorway_source_title | remove: ' RX' | remove: ' Rx'
                assign colorway_style_title = colorway_style_title | remove: ' RX'
              endif
              assign title_prefix = colorway_source_title | slice: 0, colorway_style_title.size
              if title_prefix == colorway_style_title
                assign selected_colorway = colorway_source_title | remove_first: colorway_style_title | strip
              endif
            endif

            assign collection_description = product.metafields.custom.collection_description.value | default: product.description

            assign selected_url = product.url

            assign editorial_position = visible_style_count | modulo: 2
          -%}

          {%- if selected_variant and show_style -%}
          {%- liquid
            assign visible_style_count = visible_style_count | plus: 1
            if style_key != blank
              assign seen_style_keys = seen_style_keys | append: style_marker
            endif
          -%}
          <tejesta-editorial-product
            role="article"
            class="tejesta-editorial-product{% if editorial_position == 1 %} tejesta-editorial-product--reverse{% endif %}{% if forloop.last %} tejesta-editorial-product--last-visible{% endif %}"
            data-tejesta-filter-card
            data-tejesta-editorial-product
            {% render 'tejesta-product-filter-attributes', product: product, collection: collection %}
          >
            <div class="tejesta-editorial-product__content">
              <h2 class="tejesta-editorial-product__title">
                <a href="{{ selected_url }}" data-editorial-product-link>
                  {{ style_title | escape }}
                </a>
              </h2>

              <p
                class="tejesta-editorial-product__colorway{% if selected_colorway == blank %} is-hidden{% endif %}"
                data-editorial-colorway
                aria-live="polite"
              >
                {{ selected_colorway | escape }}
              </p>

              {%- if section.settings.show_description and collection_description != blank -%}
                <div class="tejesta-editorial-product__description">
                  {{ collection_description | strip_html | truncatewords: section.settings.description_words }}
                </div>
              {%- endif -%}
            </div>

            <div class="tejesta-editorial-product__media">
              <a
                class="tejesta-editorial-product__image-link"
                href="{{ selected_url }}"
                aria-label="{{ product.title | escape }}"
                data-editorial-product-link
              >
                {%- if selected_image != blank -%}
                  {{
                    selected_image
                    | image_url: width: 1800
                    | image_tag:
                      widths: '480, 720, 960, 1200, 1500, 1800',
                      sizes: '(min-width: 990px) 50vw, 100vw',
                      loading: 'lazy',
                      class: 'tejesta-editorial-product__image',
                      alt: product.title
                  }}
                {%- else -%}
                  {{ 'product-apparel-2' | placeholder_svg_tag: 'tejesta-editorial-product__placeholder' }}
                {%- endif -%}
              </a>
            </div>

            {% render 'tejesta-family-thumbnails', product: product, placement: 'editorial' %}

            <div class="tejesta-editorial-product__divider" aria-hidden="true">
              <img
                class="tejesta-editorial-product__divider-image"
                src="{{ 'tejesta-line-art-divider.svg' | asset_url }}"
                width="1288"
                height="20"
                loading="lazy"
                alt=""
              >
            </div>
          </tejesta-editorial-product>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        {% render 'pagination', paginate: paginate, anchor: '' %}
      {%- endif -%}
    {%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "TEJESTA Editorial",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 60,
      "step": 4,
      "default": 60,
      "label": "Products per page"
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "default": true,
      "label": "Show filters"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "default": true,
      "label": "Show product descriptions"
    },
    {
      "type": "range",
      "id": "description_words",
      "min": 12,
      "max": 72,
      "step": 3,
      "default": 42,
      "label": "Description length"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ]
}
{% endschema %}
