{%- style -%}
  #TejestaCollectionSeven-{{ section.id }} {
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
  }

  #TejestaCollectionSeven-{{ section.id }} .tejesta-collection-seven__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 112rem;
    margin: 0 auto;
    padding: 4rem 2rem 4rem;
    text-align: center;
  }

  #TejestaCollectionSeven-{{ section.id }} .tejesta-collection-seven__eyebrow {
    display: block;
    width: clamp(11.7rem, 11.5vw, 16.55rem);
    height: auto;
    margin: 0;
  }

  #TejestaCollectionSeven-{{ section.id }} .tejesta-collection-seven__logo {
    display: block;
    width: clamp(16.8rem, 17.3vw, 25.2rem);
    height: auto;
    margin-top: 1.7rem;
  }

  #TejestaCollectionSeven-{{ section.id }} .tejesta-collection-seven__text {
    max-width: 105rem;
    margin-top: 3.3rem;
    font-family: 'TEJESTA Jost', var(--font-body-family);
    font-size: clamp(1.3rem, 1.34vw, 2rem);
    font-weight: 300;
    line-height: 1.45;
    letter-spacing: 0;
  }

  #TejestaCollectionSeven-{{ section.id }} .tejesta-collection-seven__text p {
    margin: 0;
  }

  #TejestaCollectionSeven-{{ section.id }} .tejesta-collection-seven__button {
    --tejesta-frame-button-width: 16rem;
    --tejesta-frame-button-height: 4.3rem;
    --tejesta-frame-button-padding: 0 2.8rem;
    --tejesta-frame-button-font-size: 1.4rem;

    margin-top: 4.3rem;
  }

  @media screen and (max-width: 749px) {
    #TejestaCollectionSeven-{{ section.id }} .tejesta-collection-seven__inner {
      padding: 4rem 2rem 4rem;
    }

    #TejestaCollectionSeven-{{ section.id }} .tejesta-collection-seven__eyebrow {
      width: min(12rem, 44vw);
    }

    #TejestaCollectionSeven-{{ section.id }} .tejesta-collection-seven__text {
      max-width: 35rem;
      margin-top: 2.6rem;
      line-height: 1.45;
    }

    #TejestaCollectionSeven-{{ section.id }} .tejesta-collection-seven__button {
      margin-top: 3.4rem;
    }
  }
{%- endstyle -%}

<section
  id="TejestaCollectionSeven-{{ section.id }}"
  class="tejesta-collection-seven color-{{ section.settings.color_scheme }} gradient"
>
  <div class="tejesta-collection-seven__inner">
    {%- if section.settings.eyebrow != blank -%}
      <img
        class="tejesta-collection-seven__eyebrow"
        src="{{ 'tejesta-collection-label.svg' | asset_url }}"
        width="331"
        height="24"
        loading="lazy"
        alt="{{ section.settings.eyebrow | escape }}"
      >
    {%- endif -%}

    <img
      class="tejesta-collection-seven__logo"
      src="{{ 'tejesta-seven.png' | asset_url }}"
      width="3201"
      height="954"
      loading="lazy"
      alt="{{ section.settings.logo_alt | escape }}"
    >

    {%- if section.settings.text != blank -%}
      <div class="tejesta-collection-seven__text rte">
        {{ section.settings.text }}
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a
        class="button--tejesta-frame tejesta-collection-seven__button"
        {% if section.settings.button_link == blank %}
          role="link" aria-disabled="true"
        {% else %}
          href="{{ section.settings.button_link }}"
        {% endif %}
      >
        {{- section.settings.button_label | escape -}}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "TEJESTA Collection Seven",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "COLLECTION"
    },
    {
      "type": "text",
      "id": "logo_alt",
      "label": "Logo alt text",
      "default": "SEVEN"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Our newest work, and our most considered. New silhouettes, new colorways,<br>the same intention moving through it all like wind across the desert.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "TEJESTA Collection Seven"
    }
  ]
}
{% endschema %}
